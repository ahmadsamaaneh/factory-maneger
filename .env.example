# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=factory_management
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# bcrypt
BCRYPT_ROUNDS=12

# System Admin (NOT stored in database — env-only credentials)
ADMIN_EMAIL=admin@system.com
ADMIN_PASSWORD=Admin@123456

# ── Frontend (Vite) ─────────────────────────────────────────────
# انسخ هذه الأسطر إلى ملف frontend/.env إذا احتجت (مثلاً فتح التطبيق من هاتف على نفس الشبكة):
# VITE_API_BASE_URL=http://YOUR_PC_IP:3000/api/v1
